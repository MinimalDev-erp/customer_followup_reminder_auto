<odoo>
    <record id="ir_cron_customer_followup_reminder" model="ir.cron">
        <field name="name">Customer Follow-up Reminder</field>
        <field name="model_id" ref="model_customer_followup_reminder"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_followup_reminder()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
